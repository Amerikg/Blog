---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';
import { allPosts } from '../utils/posts.js';

const pageTitle = "Reseñas | Amerik's Reading Corner";
---
<BaseLayout pageTitle={pageTitle}>
 <section class="inner-page">
  <header class="inner-heading">
    <div><p class="eyebrow">El diario de lectura</p><h1>Todas las reseñas</h1></div>
    <p>Opiniones y notas de las historias que he leído, ordenadas de la más reciente a la más antigua.</p>
  </header>
  <ul class="review-grid">
    {allPosts.map((post, index) => (
      <BlogPost url={post.url} title={post.frontmatter.title} pubDate={post.frontmatter.pubDate} tags={[post.frontmatter.genre]} description={post.frontmatter.description} bookAuthor={post.frontmatter.bookAuthor} index={index} />
    ))}
  </ul>
  {allPosts.length === 0 && <p class="mt-8">Todavía no hay reseñas publicadas.</p>}
 </section>
</BaseLayout>
