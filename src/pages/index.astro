---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';
import { allPosts } from '../utils/posts.js';

const recentReads = allPosts.slice(0, 3);
const genres = [...new Set(recentReads.map((post) => post.frontmatter.genre).filter(Boolean))];
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---
<BaseLayout pageTitle="Amerik's Reading Corner">
  <section class="hero" data-current-readings data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey} aria-label="Lecturas actuales">
    <div class="hero-copy">
      <p class="eyebrow hero-label"><span></span>Lectura actual</p>
      <div class="hero-reading" aria-live="polite" aria-atomic="true">
        <h1 data-current-title>Un momento entre páginas</h1>
        <p class="hero-author" data-current-author hidden></p>
        <p data-current-description>Cargando lectura actual…</p>
      </div>
      <div class="hero-navigation" data-current-navigation hidden aria-label="Navegar por las lecturas actuales">
        <button type="button" data-current-previous aria-label="Lectura anterior">← Anterior</button>
        <span data-current-position></span>
        <button type="button" data-current-next aria-label="Siguiente lectura">Siguiente →</button>
      </div>
      <p class="hero-status" data-current-status role="status"></p>
    </div>
    <div class="hero-image" data-current-cover>
      <span data-current-cover-status>Portada no disponible</span>
    </div>
  </section>

  <section class="editorial-section" id="resenas">
    <div class="section-header">
      <div><p class="eyebrow">Selección de la semana</p><h2>Últimas reseñas</h2></div>
      <div class="filter-pills" aria-label="Filtrar reseñas por género">
        <button type="button" class="active" aria-pressed="true" data-review-filter="all">Todos</button>
        {genres.map((genre) => <button type="button" aria-pressed="false" data-review-filter={genre}>{genre}</button>)}
      </div>
    </div>
    <ul class="review-grid">
      {recentReads.map((post, index) => (
        <BlogPost url={post.url} title={post.frontmatter.title} pubDate={post.frontmatter.pubDate} tags={[post.frontmatter.genre]} description={post.frontmatter.description} bookAuthor={post.frontmatter.bookAuthor} index={index} />
      ))}
    </ul>
    {recentReads.length === 0 && <p class="mt-8">Todavía no hay reseñas publicadas.</p>}
    <p class="more-reviews"><a href="/blog">Ver todas las reseñas →</a></p>
  </section>

  <section class="goal-section">
    <div>
      <p class="eyebrow">Objetivo anual · Goodreads</p>
      <h2>Un año para<br /><em>seguir leyendo.</em></h2>
      <p>La meta no es leer deprisa, sino mantener viva la curiosidad. Este es el espacio para el recorrido de Amerik por los libros que acompañan el año.</p>
    </div>
    <div class="goal-detail">
      <div class="goal-ring"><div><strong>—</strong><span>Libros</span></div></div>
      <div class="goal-text">
        <p>El objetivo anual estará disponible cuando se configure el enlace de Goodreads.</p>
        <div class="goal-numbers"><span><strong>—</strong>Por descubrir</span><span><strong>—</strong>Libros al mes</span></div>
        <a href="https://www.goodreads.com/amerikg" class="text-link">Ver Goodreads →</a>
      </div>
    </div>
  </section>

  <section class="recommend-section">
    <div>
      <p class="eyebrow">Recomendaciones abiertas</p>
      <h2>¿Qué libro<br /><em>recomiendas?</em></h2>
      <p>Esta revista también se construye con tus lecturas. Cuéntanos qué libro no has podido olvidar y por qué.</p>
    </div>
    <form class="recommend-form">
      <label>Título del libro<input type="text" placeholder="Ej. Los años" disabled /></label>
      <label>Autor o autora<input type="text" placeholder="Ej. Annie Ernaux" disabled /></label>
      <label>¿Por qué deberíamos leerlo?<textarea placeholder="Cuéntanos en unas líneas..." rows="3" disabled></textarea></label>
      <button type="button" disabled>Enviar recomendación →</button>
      <p class="form-note">Las recomendaciones estarán disponibles próximamente.</p>
    </form>
  </section>
  <script>
    import '../scripts/current-readings.js';
    const buttons = document.querySelectorAll('[data-review-filter]');
    const cards = document.querySelectorAll('[data-review-genre]');
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const selected = button.getAttribute('data-review-filter');
        buttons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        cards.forEach((card) => {
          card.toggleAttribute('hidden', selected !== 'all' && card.getAttribute('data-review-genre') !== selected);
        });
      });
    });
  </script>
</BaseLayout>
