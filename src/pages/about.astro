---
import BaseLayout from '../layouts/BaseLayout.astro';
import recommendationsData from '../data/recommendations.json';

interface Recommendation {
  title: string;
  author: string;
  description: string;
  recommendedBy: string;
}

const recommendations: Recommendation[] = recommendationsData;
---
<BaseLayout pageTitle="Nosotros | Amerik's Reading Corner">
  <section class="inner-page recommendations-page">
    <header class="inner-heading">
      <div>
        <p class="eyebrow">Una comunidad de lectores</p>
        <h1>Leemos juntos.</h1>
      </div>
      <p>Un espacio para descubrir los libros que otros lectores recomiendan y las historias que quieren compartir.</p>
    </header>

    <div class="recommendations-heading">
      <div>
        <p class="eyebrow">La comunidad recomienda</p>
        <h2>Libros recomendados</h2>
      </div>
      <span>{recommendations.length} {recommendations.length === 1 ? 'recomendación' : 'recomendaciones'}</span>
    </div>

    {recommendations.length > 0 ? (
      <ul class="recommendations-grid">
        {recommendations.map((recommendation, index) => (
          <li class="community-card">
            <div class:list={['community-card-art', ['sand', 'sage', 'rose'][index % 3]]}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <span>Recomendación <b aria-hidden="true">●</b></span>
            </div>
            <div class="community-card-body">
              <p class="eyebrow">Recomendado por {recommendation.recommendedBy}</p>
              <h3>{recommendation.title}</h3>
              <p class="community-author">{recommendation.author}</p>
              <p>{recommendation.description}</p>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <div class="recommendations-empty">
        <p class="eyebrow">Próximamente</p>
        <h3>Una historia compartida<br /><em>empieza aquí.</em></h3>
        <p>Aún no hay recomendaciones de lectores publicadas. El envío de recomendaciones estará disponible más adelante.</p>
      </div>
    )}
    <a class="text-link recommendations-back" href="/">← Volver a lecturas</a>
  </section>
</BaseLayout>
