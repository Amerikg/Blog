---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allTags } from '../../utils/posts.js';
---
<BaseLayout pageTitle="Géneros | Amerik's Reading Corner">
  <section class="inner-page">
    <header class="inner-heading"><div><p class="eyebrow">Explora el diario</p><h1>Géneros</h1></div><p>Descubre las reseñas por género y tema.</p></header>
    <ul class="mt-8 flex flex-wrap gap-3">
      {allTags.map((tag) => <li><a href={`/tags/${encodeURIComponent(tag)}`} class="inline-block rounded-full border border-border px-5 py-2 text-sm hover:border-primary hover:text-primary-ink">{tag}</a></li>)}
    </ul>
  </section>
</BaseLayout>
