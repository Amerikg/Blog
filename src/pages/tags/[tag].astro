---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPost from '../../components/BlogPost.astro';
import { allPosts, allTags } from '../../utils/posts.js';

export function getStaticPaths() {
  return allTags.map((tag) => ({
    params: { tag },
    props: { posts: allPosts.filter((post) => post.frontmatter.tags.includes(tag)) }
  }));
}
const { tag } = Astro.params;
const { posts } = Astro.props;
---
<BaseLayout pageTitle={`${tag} | Amerik's Reading Corner`}>
  <section class="inner-page">
    <header class="inner-heading"><div><p class="eyebrow">Explora el diario</p><h1>{tag}</h1></div><p>Reseñas etiquetadas con {tag}.</p></header>
    <ul class="review-grid">
      {posts.map((post, index) => <BlogPost url={post.url} title={post.frontmatter.title} pubDate={post.frontmatter.pubDate} tags={[post.frontmatter.genre]} description={post.frontmatter.description} bookAuthor={post.frontmatter.bookAuthor} index={index} />)}
    </ul>
  </section>
</BaseLayout>
