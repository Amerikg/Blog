---
import BaseLayout from './BaseLayout.astro';
import { allPosts } from '../utils/posts.js';
const { frontmatter } = Astro.props;
const authorSuffix = ` - ${frontmatter.bookAuthor}`;
const bookTitle = frontmatter.bookAuthor && frontmatter.title.endsWith(authorSuffix)
  ? frontmatter.title.slice(0, -authorSuffix.length)
  : frontmatter.title;
const formatDate = (date) => new Date(date).toLocaleDateString('es-MX', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC'
});
const postIndex = allPosts.findIndex((post) => post.url === Astro.url.pathname.replace(/\/$/, ''));
const number = postIndex >= 0 ? String(postIndex + 1).padStart(2, '0') : null;
const tones = ['sand', 'sage', 'rose'];
const tone = tones[Math.max(postIndex, 0) % tones.length];
const scores = [
  { label: 'Estrellas', value: frontmatter.rating, path: 'M12 3 14.8 8.7 21 9.6 16.5 14 17.6 20.2 12 17.3 6.4 20.2 7.5 14 3 9.6 9.2 8.7Z' },
  { label: 'Lágrimas', value: frontmatter.tears, path: 'M12 3 C9 7 6.5 10.5 6.5 14.5 a5.5 5.5 0 0 0 11 0 C17.5 10.5 15 7 12 3Z' },
  { label: 'Picante', value: frontmatter.spice, path: 'M12 3 C13 7 10 8 10 11 C9 10 8.5 9 8.5 8 C6 10 5 12.5 5.5 15.5 a6.5 6.5 0 0 0 13 0 C18.5 10.5 15 8 12 3Z' }
];
for (const { label, value } of scores) {
  if (value != null && (!Number.isInteger(value) || value < 0 || value > 5)) {
    throw new Error(`${frontmatter.title}: ${label} debe ser un número entero entre 0 y 5.`);
  }
}
---
<BaseLayout pageTitle={`${frontmatter.title} | Amerik's Reading Corner`}>
  <article class="review-page">
    <header class="review-hero">
      <div class="review-hero-copy">
        <a class="eyebrow back-link" href="/blog">← &nbsp; Volver a reseñas</a>
        <div>
          <p class="eyebrow">Reseña · {frontmatter.genre}</p>
          <h1>{bookTitle}</h1>
          {frontmatter.bookAuthor && <p class="review-author">de {frontmatter.bookAuthor}</p>}
        </div>
        {frontmatter.rating != null && (
          <div class="review-rating">
            <span class="stat-label">Calificación</span>
            <span class="rating-stars" aria-hidden="true">{Array.from({ length: 5 }, (_, index) => <span class:list={{ filled: index < frontmatter.rating }}>★</span>)}</span>
            <span>{frontmatter.rating} de 5</span>
          </div>
        )}
      </div>
      <div class:list={['review-cover-stage', tone]}>
        <div class="review-cover-art">
          <div class="review-cover-inner">
            <p class="review-cover-genre">{frontmatter.genre}</p>
            <div><h2>{bookTitle}</h2><p>{frontmatter.bookAuthor}</p></div>
            {number && <span class="review-cover-number">{number}</span>}
          </div>
        </div>
      </div>
    </header>
    <div class="review-body">
      <aside class="emotional-map">
        <p class="stat-label">Mapa emocional</p>
        <dl class="emotional-scores">
          {scores.map(({ label, value, path }) => (
            <div class="emotional-score">
              <dt>{label}</dt>
              <dd>
                <span class="emotional-icons" role="img" aria-label={value != null ? `${value} de 5` : 'Sin registrar'}>
                  {Array.from({ length: 5 }, (_, index) => (
                    <svg class:list={{ filled: value != null && index < value }} aria-hidden="true" viewBox="0 0 24 24"><path d={path} stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" /></svg>
                  ))}
                </span>
                {value == null && <span class="score-unavailable">Sin registrar</span>}
              </dd>
            </div>
          ))}
        </dl>
        <dl class="reading-dates">
          {frontmatter.readStart && <div><dt>Inicio</dt><dd>{formatDate(frontmatter.readStart)}</dd></div>}
          {frontmatter.readEnd && <div><dt>Finalización</dt><dd>{formatDate(frontmatter.readEnd)}</dd></div>}
        </dl>
        <ul class="mt-6 flex flex-wrap gap-2">
          {frontmatter.tags.map((tag) => <li><a href={`/tags/${encodeURIComponent(tag)}`} class="text-xs text-primary-ink hover:underline">{tag}</a></li>)}
        </ul>
        <button type="button" class="save-review-placeholder" disabled>⌑ &nbsp; Guardar reseña</button>
        <p class="save-review-note">Disponible próximamente.</p>
      </aside>
      <div>
        <p class="review-lede">{frontmatter.description}</p>
        <div class="review-content"><slot /></div>
        <div class="review-byline"><div><span class="stat-label">Reseña por</span><span>{frontmatter.author}</span></div><a class="text-link" href="/blog">Ver más reseñas →</a></div>
      </div>
    </div>
  </article>
</BaseLayout>
